        <mxCell id="item16" parent="1" vertex="1" value="The runtime requires an exact active source selection for populated trace fields. No supplier form or connection is invented here." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;fontStyle=0;">
          <mxGeometry x="84" y="394" width="715" height="44.2" as="geometry" />
