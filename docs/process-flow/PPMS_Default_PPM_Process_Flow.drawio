          <mxGeometry x="84" y="577" width="715" height="46.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="item19" parent="1" vertex="1" value="Same-record source selection is explicitly rejected. Verify the separate-record / first-record bootstrap arrangement for these streams before rollout." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;fontStyle=0;">
          <mxGeometry x="84" y="649" width="715" height="44.2" as="geometry" />
