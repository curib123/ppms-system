        <mxCell id="item20" parent="1" vertex="1" value="03 / PRESERVE THE ACTUAL CONFIGURATION" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#52647A;fontStyle=1;">
          <mxGeometry x="82" y="807" width="719" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="item21" parent="1" vertex="1" value="CONN-004 and CONN-005 remain ACTIVE in the seed, but their target paths are obsolete. The diagrams use the corresponding current row paths.&#10;&#10;PPM-005 / PPM-006 stay RESERVED. PPM-025 is absent. No onward source link is configured for frozen eggyolk or an external pan-greaser handoff." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;fontStyle=0;">
          <mxGeometry x="84" y="850" width="715" height="110.5" as="geometry" />
        </mxCell>
        <mxCell id="item22" parent="1" vertex="1" value="04 / RUNTIME AND CLIENT BOUNDARIES" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#52647A;fontStyle=1;">
          <mxGeometry x="868" y="250" width="730" height="19.5" as="geometry" />
        </mxCell>
        <mxCell id="item23" parent="1" vertex="1" value="Checked, Reviewed and Approved are independent guidance on the exact content revision. Review does not gate an otherwise eligible published source.&#10;&#10;Corrections return the record to ACTIVE with a CORRECTED revision. Resubmission and publication remain separate. Unresolved genuine trace impacts still block publication.&#10;&#10;Flutter local entry and the admin panel are planned client work in this checkout; this PDF is not proof of client delivery." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;fontStyle=0;">
          <mxGeometry x="872" y="293" width="722" height="176.8" as="geometry" />
