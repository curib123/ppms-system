        <mxCell id="item15" parent="1" vertex="1" value="PPM-017: entries[].packingCode&#10;PPM-024: entries[].productCode&#10;PPM-024: entries[].rollCode" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#98610A;fontStyle=1;">
