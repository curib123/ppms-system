    },
    {
      "key": "offline.maxAccessHours",
      "valueJson": 24,
      "valueType": "INTEGER",
      "description": "Maximum offline access window after a successful server authorization snapshot; revalidation required after expiry."
    },
    {
      "key": "offline.maxCachedRecordDays",
      "valueJson": 7,
      "valueType": "INTEGER",
      "description": "Default authorized operational record cache horizon per device; does not affect server retention."
    },
    {
      "key": "sync.batchSize",
      "valueJson": 50,
      "valueType": "INTEGER",
      "description": "Maximum mutations processed per bounded sync push batch."
    },
    {
      "key": "sync.autoOnReconnect",
      "valueJson": true,
      "valueType": "BOOLEAN",
      "description": "Automatically attempt foreground synchronization after API connectivity is confirmed."
    },
    {
      "key": "sync.criticalApprovalsRequireOnline",
      "valueJson": true,
      "valueType": "BOOLEAN",
      "description": "Require live server validation for FSQA/Supervisor/Plant Manager official workflow transitions."
    },
    {
      "key": "sync.localQueueDeleteAfterAck",
      "valueJson": true,
      "valueType": "BOOLEAN",
      "description": "Queue compaction may remove a mutation only after its committed server ACK is durably stored locally."
    },
    {
      "key": "sync.safeFieldAutoMerge",
      "valueJson": true,
