  "notes": [
    "Trace engine is generic across all PPMs: seed every real-form matrix connection with its status and do not hard-code only the current peanut route.",
    "PPM-005 and PPM-006 are RESERVED and must not be operationally selectable by default.",
    "Only ACTIVE connections are selectable by downstream Personnel.",
    "Policy-only pseudo processes are not seeded as PpmForm records.",
    "Template definitionJson must be populated from controlled source forms; do not invent missing fields.",
    "Role dashboards are calculated server-side from normalized indexed workflow/record data; no routine dashboard scans of revision JSON.",
    "System settings are seeded with default red theme, SYSTEM appearance and 2-year ARCHIVE_ONLY retention.",
    "Notifications, secure sessions, user appearance preference and system maintenance job history are part of the canonical implementation schema."
  ],
  "systemSettings": [
    {
      "key": "retention.years",
      "valueType": "INTEGER",
      "description": "Default operational data retention/archive eligibility in years.",
      "valueJson": 2
    },
    {
      "key": "retention.mode",
      "valueType": "STRING",
      "description": "Archive-first retention. Destructive purge disabled by default.",
      "valueJson": "ARCHIVE_ONLY"
    },
    {
